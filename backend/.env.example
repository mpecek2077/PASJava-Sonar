# Copy this file to backend/.env and fill in your local values.
# Never commit backend/.env with real secrets.

# Spring profile: dev (local MySQL) | docker (Docker Compose) | test (H2 in-memory)
SPRING_PROFILES_ACTIVE=dev

# MySQL configuration
MYSQL_CONTAINER_NAME=budget-split-mysql
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=budget_db
MYSQL_USER=app_user
MYSQL_PASSWORD=change-me-app-password
TZ=UTC

# JWT signing secret (must be at least 64 bytes for HS512)
JWT_SECRET=change-me-to-a-secure-random-secret-key-at-least-64-bytes-long-for-hs512
